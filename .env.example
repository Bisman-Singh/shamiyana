# Server only. Never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Comma separated Gemini model ids, tried in order.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# Optional. AI requests one server instance accepts per UTC day.
AI_DAILY_REQUEST_CAP=2000
