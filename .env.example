# Server only. Never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Comma separated Gemini model ids, tried in order.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash

# Optional. AI requests accepted per UTC day: by all instances together when
# Redis is set, otherwise by each instance.
AI_DAILY_REQUEST_CAP=2000

# Optional. AI requests one client may make per UTC day.
AI_DAILY_CLIENT_CAP=100

# Optional, set both. Upstash Redis over REST, as the Vercel marketplace names
# them. Without them, limits stay in each instance's memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
